<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_background"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:gravity="center">

    <!-- Top Header: Location -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_widget_location"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Madrid"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_high_low"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↑26° ↓14°"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Center Section: Weather Icon & Temperature -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@drawable/ic_widget_sun"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_temperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24°"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Cielo despejado"
                android:textColor="#CBD5E1"
                android:textSize="11sp"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Section: Detailed Micro-Stats Bar -->
    <LinearLayout
        android:id="@+id/widget_stats_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_chip_background"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="5dp"
        android:gravity="center">

        <!-- Feels Like / Sensacion -->
        <TextView
            android:id="@+id/widget_feels_like"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sens 24°"
            android:textColor="#E2E8F0"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="·"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Rain Probability -->
        <TextView
            android:id="@+id/widget_rain_prob"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🌧 0%"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="·"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Wind Speed -->
        <TextView
            android:id="@+id/widget_wind"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:text="💨 12 km/h"
            android:textColor="#E2E8F0"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1" />

    </LinearLayout>

</LinearLayout>
