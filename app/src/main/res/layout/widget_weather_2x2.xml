<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_background"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_vertical">

    <!-- Fila 1 (Superior): Nombre de la ubicación/municipio + Máxima y Mínima -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_location_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_widget_location"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="8dp"
            android:text="Madrid"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_high_low"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↑24°  ↓17°"
            android:textColor="#E2E8F0"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Fila 2 (Central): Icono meteorológico grande a la izquierda y Temperatura Actual destacada a la derecha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_widget_sun"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="21°"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Fila 3 (Inferior): Sensación Térmica completa y legible en una sola línea -->
    <TextView
        android:id="@+id/widget_feels_like"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sensación 20°"
        android:textColor="#CBD5E1"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>

