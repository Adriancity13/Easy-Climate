<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Día / Mediodía: Gradiente azul cielo diurno nítido y de alto contraste -->
    <gradient
        android:angle="315"
        android:startColor="#1D4ED8"
        android:centerColor="#1E3A8A"
        android:endColor="#0F172A"
        android:type="linear" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1.5dp"
        android:color="#FF60A5FA" />
</shape>
