<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Amanecer: Gradiente radiante cálido de tonos dorados y anaranjados de alto contraste -->
    <gradient
        android:angle="315"
        android:startColor="#C2410C"
        android:centerColor="#7C2D12"
        android:endColor="#1E0E08"
        android:type="linear" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1.5dp"
        android:color="#FFF97316" />
</shape>
